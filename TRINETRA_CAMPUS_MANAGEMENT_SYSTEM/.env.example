# TRINETRA Environment Configuration Example
APP_NAME=TRINETRA
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database Configuration
# Local SQLite fallback for testing/development:
DATABASE_URL=sqlite+aiosqlite:///trinetra.db
# Production PostgreSQL with btree_gist support:
# DATABASE_URL=postgresql+asyncpg://trinetra_user:trinetra_secure_pass_2026@localhost:5432/trinetra_db

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Temporary Room Hold TTL (Minutes)
ROOM_HOLD_TTL_MINUTES=5

# Gemini AI API Configuration (Optional - built-in structured RAG fallback works out of the box)
GEMINI_API_KEY=
